# MMA Backend — Environment Configuration
# Copy to .env and customize

# Application
APP_NAME=MMA Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://mma:mma@localhost:5432/mma

# Redis
REDIS_URL=redis://localhost:6379/0

# ESPN API (no auth required)
ESPN_BASE_URL=https://sports.core.api.espn.com/v2/sports/mma
ESPN_RATE_LIMIT=10.0
ESPN_PAGE_LIMIT=100

# TheSportsDB (free test key: 3)
TSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json
TSDB_API_KEY=3

# Octagon API (no auth required)
OCTAGON_BASE_URL=https://api.octagon-api.com

# Sync Configuration
SYNC_DEFAULT_PROVIDER=espn
SYNC_BATCH_SIZE=500
# Enable the scheduler to auto-start the SyncManager on API boot (true in docker-compose)
SYNC_ENABLED=false

# Auth (REQUIRED before deploying; default dev secret must not reach production)
JWT_SECRET=change-me-before-deploy
JWT_ALGORITHM=HS256
